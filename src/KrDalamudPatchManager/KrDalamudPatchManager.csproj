<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KR.Dalamud.PatchManager</AssemblyName>
    <RootNamespace>KrDalamudPatchManager</RootNamespace>
    <ApplicationIcon>..\..\assets\launcher-icon\launcher-icon.ico</ApplicationIcon>
    <Version>0.2.15</Version>
    <AssemblyVersion>0.2.15.0</AssemblyVersion>
    <FileVersion>0.2.15.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
